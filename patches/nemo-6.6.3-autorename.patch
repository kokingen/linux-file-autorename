+/* nemo-autorename: on a name conflict keep both (rename the incoming item,
+ * merge same-named folders) instead of asking.  Set NEMO_NO_AUTORENAME=1
+ * in the environment to get the original conflict dialog back. */
+static gboolean
+autorename_enabled (void)
+{
+	const char *v = g_getenv ("NEMO_NO_AUTORENAME");
+	return !(v != NULL && *v != '\0' && strcmp (v, "0") != 0);
